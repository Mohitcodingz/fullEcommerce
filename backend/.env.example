# Required for backend startup and authentication.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Required for product image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for Cashfree payments (the current config reads these RAZORPAY_* names).
RAZORPAY_API_KEY=
RAZORPAY_API_SECRET=

# Gmail SMTP credentials for registration verification emails.
# Use a Google App Password (with 2-Step Verification enabled), not your normal password.
EMAIL_USER=
EMAIL_PASS=